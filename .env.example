# Имя приложения
APP_NAME=Universal FastAPI Backend
# Версия приложения
APP_VERSION=0.1.0
# Среда окружения (local, development, staging, production)
ENVIRONMENT=local
# Режим отладки (True или False)
DEBUG=True

# Префикс для API роутов
API_V1_PREFIX=/api/v1

# Настройки базы данных PostgreSQL
# Имя пользователя базы данных
POSTGRES_USER=postgres
# Пароль базы данных
POSTGRES_PASSWORD=postgres
# Хост базы данных (например, db в Docker или localhost для локальной работы)
POSTGRES_HOST=db
# Порт базы данных
POSTGRES_PORT=5432
# Название базы данных
POSTGRES_DB=app

# Включить логирование запросов к БД (True или False)
DB_ECHO=False
# Автоматическое создание схемы БД при запуске
AUTO_CREATE_DATABASE=True

# Секретный ключ для подписи JWT токенов (обязательно смените в продакшене)
SECRET_KEY=change-this-secret-in-production
# Алгоритм шифрования JWT
JWT_ALGORITHM=HS256
# Время жизни access-токена в минутах (по умолчанию 24 часа)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Разрешить автосоздание админа (True или False)
BOOTSTRAP_ADMIN_ENABLED=True

# Разрешенные источники для CORS (в формате JSON массива)
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
# Разрешенные хосты
TRUSTED_HOSTS=["*"]

# Уровень логирования (INFO, DEBUG, ERROR)
LOG_LEVEL=INFO
# Выводить логи в формате JSON
LOG_JSON=True

# Включить авторизацию для MCP сервера
MCP_AUTH_ENABLED=True
